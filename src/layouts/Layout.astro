---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'CairnOSS — Building Open. Building Better.',
	description = 'CairnOSS is an open-source software organization focused on building, maintaining, and contributing to thoughtful, powerful, and accessible developer tools and infrastructure.',
} = Astro.props;

const basePath = import.meta.env.BASE_URL.endsWith('/')
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;
const siteUrl = Astro.site ?? new URL('https://cairnoss.github.io');
const homeUrl = new URL(basePath, siteUrl).href;
const rawPathname = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonicalUrl = new URL(rawPathname, siteUrl).href;
const logoPath = `${basePath}logo_transparent.png`;
const sitemapPath = `${basePath}sitemap.xml`;
const manifestPath = `${basePath}site.webmanifest`;
const ogImageUrl = new URL(logoPath, siteUrl).href;

const structuredData = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'Organization',
			'@id': `${homeUrl}#organization`,
			name: 'CairnOSS',
			alternateName: 'Cairn + Open Source Software',
			slogan: 'Building Open. Building Better.',
			url: homeUrl,
			email: 'cairnoss21@gmail.com',
			logo: {
				'@type': 'ImageObject',
				url: ogImageUrl,
			},
			description,
			sameAs: ['https://github.com/cairnoss'],
		},
		{
			'@type': 'WebSite',
			'@id': `${homeUrl}#website`,
			url: homeUrl,
			name: 'CairnOSS',
			description,
			publisher: {
				'@id': `${homeUrl}#organization`,
			},
			inLanguage: 'en',
		},
		{
			'@type': 'WebPage',
			'@id': canonicalUrl,
			url: canonicalUrl,
			name: title,
			description,
			isPartOf: {
				'@id': `${homeUrl}#website`,
			},
			about: {
				'@id': `${homeUrl}#organization`,
			},
			inLanguage: 'en',
		},
	],
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="color-scheme" content="light dark" />

		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="author" content="CairnOSS" />
		<meta
			name="keywords"
			content="CairnOSS, open source software, developer tools, infrastructure, automation, open source libraries, Visnex, TrueShh, Go, Rust, TypeScript, Python"
		/>
		<meta
			name="robots"
			content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
		/>
		<link rel="canonical" href={canonicalUrl} />
		<link rel="alternate" hreflang="en" href={canonicalUrl} />
		<link rel="alternate" hreflang="x-default" href={canonicalUrl} />
		<link rel="sitemap" type="application/xml" title="Sitemap" href={sitemapPath} />
		<link rel="manifest" href={manifestPath} />

		<meta name="theme-color" media="(prefers-color-scheme: light)" content="#FAFAFA" />
		<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#09090B" />

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="en_US" />
		<meta property="og:site_name" content="CairnOSS" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:alt" content="CairnOSS stacked-stone emblem" />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={canonicalUrl} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />
		<meta name="twitter:image:alt" content="CairnOSS stacked-stone emblem" />

		<link rel="icon" type="image/png" href={logoPath} />
		<link rel="apple-touch-icon" href={logoPath} />

		<!-- Typography: Inter & JetBrains Mono -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
		/>

		<!-- Structured Data -->
		<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
	</head>
	<body>
		<a class="cairn-skip-link" href="#main-content">Skip to main content</a>
		<slot />
	</body>
</html>
